 }
 
 class AiService {
-  static const String _defaultBaseUrl = 'https://api.deepseek.com';
-  static const String _defaultModel = 'deepseek-chat';
+  /// ZeroScript bridge: the free, keyless Roblox AI agent whose HTTP API runs on
+  /// this device (the ZeroScript-Free project). It speaks the OpenAI protocol, so
+  /// the whole app works against it with no API key at all - the signed-in web
+  /// chat does the thinking. These are the defaults, so a fresh install is usable
+  /// the moment the bridge is running.
+  static const String zeroscriptBaseUrl = 'http://127.0.0.1:17614/v1';
+  static const String zeroscriptModel = 'zeroscript';
+  static const String _defaultBaseUrl = zeroscriptBaseUrl;
+  static const String _defaultModel = zeroscriptModel;
   static const String nvidiaBaseUrl = 'https://integrate.api.nvidia.com/v1';
   static const String nvidiaDefaultModel = 'z-ai/glm-5.2';
 
+  /// True for an endpoint on THIS device. The ZeroScript bridge is loopback-only
+  /// by default and ignores the Authorization header unless it was started with
+  /// ZS_API_TOKEN, so a loopback base URL needs no API key. (If the bridge WAS
+  /// started with a token, put that token in the API Key field.)
+  static bool isLoopbackBaseUrl(String baseUrl) {
+    final host = Uri.tryParse(baseUrl.trim())?.host.toLowerCase();
+    return host == '127.0.0.1' ||
+        host == 'localhost' ||
+        host == '::1' ||
+        host == '[::1]';
+  }
+
   /// Free, general-purpose chat endpoints verified in NVIDIA's NIM catalog.
   /// The live /models response is intersected with this list so unavailable or
   /// non-chat models never appear in PrivateAgent's NVIDIA model picker.
@@ -173,7 +192,20 @@ Answer questions, explain concepts, brainstorm, write emails/messages, and chat
     await prefs.setBool('api_use_system_prompt', useSystemPrompt);
   }
 
-  bool get isConfigured => _apiKey != null && _apiKey!.isNotEmpty;
+  /// A loopback endpoint (the ZeroScript bridge on this device) is usable with
+  /// no key: the bridge ignores the Authorization header unless it was started
+  /// with ZS_API_TOKEN, and a key is impossible to obtain for it otherwise.
+  bool get isConfigured =>
+      (_apiKey != null && _apiKey!.isNotEmpty) || isLoopbackBaseUrl(_baseUrl);
+
+  /// Throws unless the service can actually make a request.
+  void _requireApiKey() {
+    if (isLoopbackBaseUrl(_baseUrl)) return;
+    if (_apiKey == null || _apiKey!.isEmpty) {
+      throw Exception('API Key is not configured. Please go to Settings.');
+    }
+  }
+
   String get baseUrl => _baseUrl;
   String get model => _model;
   String get apiKey => _apiKey ?? '';
