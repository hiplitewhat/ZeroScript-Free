diff --git a/test/ai_service_test.dart b/test/ai_service_test.dart
index 26ee701..306c6b1 100644
--- a/test/ai_service_test.dart
+++ b/test/ai_service_test.dart
@@ -25,4 +25,23 @@ void main() {
     expect(AiService.nvidiaDefaultModel, 'z-ai/glm-5.2');
     expect(AiService.nvidiaFreeChatModels.first, 'z-ai/glm-5.2');
   });
+
+  test('only a loopback base URL may skip the API key', () {
+    // The ZeroScript bridge runs on this device and takes no key.
+    expect(AiService.isLoopbackBaseUrl('http://127.0.0.1:17614/v1'), isTrue);
+    expect(AiService.isLoopbackBaseUrl('http://localhost:17614/v1'), isTrue);
+    expect(AiService.isLoopbackBaseUrl('http://[::1]:17614/v1'), isTrue);
+    expect(AiService.isLoopbackBaseUrl('  http://127.0.0.1:17614/v1  '), isTrue);
+    // Anything reachable over a network still needs one.
+    expect(AiService.isLoopbackBaseUrl('https://api.deepseek.com'), isFalse);
+    expect(AiService.isLoopbackBaseUrl('http://192.168.1.50:17614/v1'), isFalse);
+    expect(AiService.isLoopbackBaseUrl('http://10.0.2.2:11434/v1'), isFalse);
+    expect(AiService.isLoopbackBaseUrl(''), isFalse);
+    expect(AiService.isLoopbackBaseUrl('not a url'), isFalse);
+  });
+
+  test('the ZeroScript bridge is the default endpoint', () {
+    expect(AiService.zeroscriptBaseUrl, 'http://127.0.0.1:17614/v1');
+    expect(AiService.zeroscriptModel, 'zeroscript');
+  });
