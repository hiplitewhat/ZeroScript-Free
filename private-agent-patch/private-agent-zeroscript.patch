diff --git a/android/app/src/main/res/xml/network_security_config.xml b/android/app/src/main/res/xml/network_security_config.xml
new file mode 100644
index 0000000..cd51284
--- /dev/null
+++ b/android/app/src/main/res/xml/network_security_config.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Cleartext HTTP is refused by default from Android 9 (API 28) on, which is why
+  a plain http:// endpoint fails at the socket level on a release build.
+
+  The ZeroScript bridge runs ON THIS DEVICE (http://127.0.0.1:17614/v1), so
+  loopback has to be allowed. Only loopback is: every other host keeps the
+  platform default, so remote providers must still be HTTPS.
+-->
+<network-security-config>
+    <domain-config cleartextTrafficPermitted="true">
+        <domain includeSubdomains="false">localhost</domain>
+        <domain includeSubdomains="false">127.0.0.1</domain>
+        <domain includeSubdomains="false">::1</domain>
+    </domain-config>
+</network-security-config>
